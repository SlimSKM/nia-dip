# Key names and placeholders only. Never put real values here.
# Create your .env with `make env-init` (generates secrets without
# printing them) and check it with `make env-check` (key names and
# statuses only). Never cat, source or grep .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,.localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=dip
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database roles (three different roles; TDH ADR-TDH-008 pattern):
# - container superuser: initialises the volume, runs bootstrap_db_roles once
POSTGRES_SUPERUSER=dip_superuser
POSTGRES_SUPERUSER_PASSWORD=change-me
# - owner: owns every object; migrations, grants, provisioning, tests
POSTGRES_USER=dip_owner
POSTGRES_PASSWORD=change-me
# - runtime: the web process; DML only, owns nothing
POSTGRES_APP_USER=dip_app
POSTGRES_APP_PASSWORD=change-me

# Signs JWT access and refresh tokens (separate from DJANGO_SECRET_KEY).
DIP_JWT_SIGNING_KEY=change-me
# TOTP required for Administrators and Reviewers (OQ-DIP-07).
DIP_REQUIRE_MFA=true
# Refresh-token cookie Secure flag (browsers accept it on http://localhost).
DIP_COOKIE_SECURE=true

# Dev tenant host (SSH tunnel: ssh -L 8020:127.0.0.1:8020 ukw-dev).
DIP_DEV_DOMAIN=dip-dev.localhost
WEB_PORT=8020
